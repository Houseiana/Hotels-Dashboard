# ---------------------------------------------------------------------------
# Houseiana Hotels — Owner/Admin Dashboard
# Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Clerk (https://dashboard.clerk.com). Leave BOTH blank to run in dev-bypass
# mode: the dashboard renders with a mock owner session and no sign-in wall.
# Set them to gate the whole dashboard behind real owner/admin sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Data source. "true" = in-memory mock data (default, no backend needed).
# "false" = talk to NEXT_PUBLIC_API_BASE_URL over REST.
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
